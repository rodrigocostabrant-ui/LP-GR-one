"use client";

import { useRef, useSyncExternalStore, type RefObject } from "react";
import GRObject, { type GRState } from "./GRObject";

function isSaveData() {
  const connection = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } })
    .connection;
  return Boolean(connection?.saveData || connection?.effectiveType === "2g");
}

function subscribe(callback: () => void) {
  const mq = window.matchMedia("(min-width: 900px)");
  mq.addEventListener("change", callback);
  return () => mq.removeEventListener("change", callback);
}

function getSnapshot() {
  return window.matchMedia("(min-width: 900px)").matches && !isSaveData();
}

function getServerSnapshot() {
  return false;
}

/**
 * Escolhe entre o objeto 3D em WebGL e uma versão estática em CSS, conforme a
 * especificação: celular e conexões limitadas recebem a versão leve. Aceita um
 * `stateRef` mutável (para animação ligada ao scroll, sem re-render do React) ou
 * um `state` fixo (convertido internamente em ref).
 */
export default function GRSignature({
  state,
  stateRef,
  size = 1.6,
  className,
}: {
  state?: GRState;
  stateRef?: RefObject<GRState>;
  size?: number;
  className?: string;
}) {
  const useWebgl = useSyncExternalStore(subscribe, getSnapshot, getServerSnapshot);
  const internalRef = useRef<GRState>(state ?? { a: 0, b: 0, rx: 0, ry: 0 });
  const resolvedRef = stateRef ?? internalRef;

  if (!useWebgl) {
    return (
      <div
        className={className}
        aria-hidden="true"
        style={{
          width: "100%",
          height: "100%",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        <span
          style={{
            font: "800 clamp(64px, 18vw, 140px)/1 var(--font-sans)",
            fontVariationSettings: "'wdth' 112",
            letterSpacing: "-0.05em",
            background:
              "linear-gradient(100deg,#5B6475 0%,#9AA3B2 22%,#EEF2F7 40%,#FFFFFF 47%,#C4CCD8 54%,#AFC4FF 64%,#6B7483 80%,#3E4656 100%)",
            WebkitBackgroundClip: "text",
            backgroundClip: "text",
            color: "transparent",
            display: "inline-block",
            animation: "gr-tilt 7s ease-in-out infinite",
          }}
        >
          GR
        </span>
        <style>{`
          @keyframes gr-tilt {
            0%, 100% { transform: rotate(-3deg) scale(1); }
            50% { transform: rotate(3deg) scale(1.03); }
          }
          @media (prefers-reduced-motion: reduce) {
            span { animation: none !important; }
          }
        `}</style>
      </div>
    );
  }

  return <GRObject stateRef={resolvedRef} size={size} className={className} />;
}
