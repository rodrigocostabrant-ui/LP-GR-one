"use client";

import { useMemo, useRef, type RefObject } from "react";
import * as THREE from "three";
import { Canvas, useFrame } from "@react-three/fiber";
import { Text } from "@react-three/drei";

/**
 * Objeto 3D "GR" — a assinatura da marca. Réplica em WebGL real (não CSS) do
 * método descrito na especificação: o monograma é cortado em 4 fatias horizontais
 * (0/32/50/68/100%), cada uma com camadas de profundidade que escurecem, e uma face
 * frontal com gradiente prata que reflete conforme a rotação. Ver `objSpec` em
 * `GR One Especificacao.dc.html`.
 */

const SLICE_CUTS = [0, 0.32, 0.5, 0.68, 1];
// Deslocamentos de paralaxe por fatia (extraídos do FR do script original).
const FR: [number, number, number, number, number][] = [
  [-0.24, -0.12, 0.38, -24, -5],
  [0.18, -0.04, -0.22, 15, 3],
  [-0.12, 0.05, 0.5, -11, -2],
  [0.28, 0.13, -0.32, 26, 6],
];
const LAYERS = 10;

export interface GRState {
  /** dispersão / abertura das fatias (0 = inteira) */
  a: number;
  /** explosão axonométrica (reorganização) */
  b: number;
  /** rotação base X, em graus */
  rx: number;
  /** rotação base Y, em graus */
  ry: number;
}

function Slice({
  index,
  size,
  stateRef,
}: {
  index: number;
  size: number;
  stateRef: RefObject<GRState>;
}) {
  const group = useRef<THREE.Group>(null);

  // Textura mutável (offset animado por quadro dentro de useFrame, fora do ciclo
  // de render do React) — recurso WebGL imperativo, padrão consagrado em R3F/Three.js
  // que a regra experimental react-hooks/refs ainda não reconhece.
  const gradientRef = useRef<THREE.CanvasTexture | null>(null);
  // eslint-disable-next-line react-hooks/refs -- init único e preguiçoso do recurso WebGL
  if (!gradientRef.current) {
    const canvas = document.createElement("canvas");
    canvas.width = 256;
    canvas.height = 8;
    const ctx = canvas.getContext("2d")!;
    const grad = ctx.createLinearGradient(0, 0, 256, 0);
    grad.addColorStop(0, "#5B6475");
    grad.addColorStop(0.22, "#9AA3B2");
    grad.addColorStop(0.4, "#EEF2F7");
    grad.addColorStop(0.47, "#FFFFFF");
    grad.addColorStop(0.54, "#C4CCD8");
    grad.addColorStop(0.64, "#AFC4FF");
    grad.addColorStop(0.8, "#6B7483");
    grad.addColorStop(1, "#3E4656");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 256, 8);
    const tex = new THREE.CanvasTexture(canvas);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.wrapS = THREE.RepeatWrapping;
    tex.repeat.set(3.2, 1);
    gradientRef.current = tex;
  }
  // eslint-disable-next-line react-hooks/refs -- leitura do recurso WebGL já inicializado acima
  const gradient = gradientRef.current;

  // Planos de corte no espaço LOCAL da fatia (caixa de 0.82em, como o
  // `line-height:.82` do protótipo). O Three.js recorta em espaço de mundo, então
  // a cada quadro eles são reprojetados pela matrixWorld da fatia — o recorte
  // acompanha a fatia quando ela se desloca, gira ou flutua.
  const fontSize = size * 0.62;
  const localPlanes = useMemo(() => {
    const fullH = fontSize * 0.82;
    const halfH = fullH / 2;
    const topY = halfH - SLICE_CUTS[index] * fullH;
    const bottomY = halfH - SLICE_CUTS[index + 1] * fullH;
    return [
      new THREE.Plane(new THREE.Vector3(0, -1, 0), topY),
      new THREE.Plane(new THREE.Vector3(0, 1, 0), -bottomY),
    ];
  }, [index, fontSize]);
  const clipPlanes = useMemo(() => localPlanes.map((p) => p.clone()), [localPlanes]);

  useFrame(() => {
    const g = group.current;
    const state = stateRef.current;
    if (!g || !state) return;
    const [dx, dy, dz, ry, rz] = FR[index];
    const e = index - 1.5;
    const { a, b } = state;
    g.position.set(a * dx * size, -(a * dy + b * e * 0.1) * size, (a * dz - b * e * 0.22) * size);
    g.rotation.y = THREE.MathUtils.degToRad(a * ry);
    g.rotation.z = THREE.MathUtils.degToRad(a * rz);
    g.updateMatrixWorld();
    clipPlanes.forEach((p, i) => p.copy(localPlanes[i]).applyMatrix4(g.matrixWorld));
    const ryRad = THREE.MathUtils.degToRad(state.ry);
    if (gradientRef.current) gradientRef.current.offset.x = Math.sin(ryRad) * 0.42;
  });

  return (
    <group ref={group}>
      {Array.from({ length: LAYERS }, (_, l) => {
        const layer = LAYERS - l;
        const t = layer / LAYERS;
        const depth = -layer * fontSize * 0.011;
        const color =
          layer === 1 ? new THREE.Color("#9FB3E6") : new THREE.Color(`hsl(222, ${16 - t * 6}%, ${58 - t * 47}%)`);
        return (
          <Text
            key={l}
            fontSize={fontSize}
            fontWeight={800}
            letterSpacing={-0.05}
            position={[0, 0, depth]}
            anchorX="center"
            anchorY="middle"
          >
            GR
            <meshBasicMaterial
              color={color}
              clippingPlanes={clipPlanes}
              side={THREE.DoubleSide}
              toneMapped={false}
            />
          </Text>
        );
      })}
      <Text
        fontSize={fontSize}
        fontWeight={800}
        letterSpacing={-0.05}
        position={[0, 0, 0]}
        anchorX="center"
        anchorY="middle"
      >
        GR
        {/* Sem iluminação, como o gradiente prata do protótipo: o "reflexo" é o
            deslocamento do mapa conforme a rotação (offset.x no useFrame). Metal PBR
            sem envMap ficava preto em quase todos os ângulos. */}
        <meshBasicMaterial
          map={gradient}
          clippingPlanes={clipPlanes}
          side={THREE.DoubleSide}
          toneMapped={false}
        />
      </Text>
    </group>
  );
}

function Rig({ size, stateRef }: { size: number; stateRef: RefObject<GRState> }) {
  const root = useRef<THREE.Group>(null);
  // Flutuação automática desligada com prefers-reduced-motion.
  const reduced = useMemo(() => window.matchMedia("(prefers-reduced-motion: reduce)").matches, []);

  useFrame(({ clock }) => {
    const g = root.current;
    const state = stateRef.current;
    if (!g || !state) return;
    const floatY = reduced ? 0 : Math.sin(clock.elapsedTime * 0.6) * size * 0.045;
    g.rotation.x = THREE.MathUtils.degToRad(state.rx);
    g.rotation.y = THREE.MathUtils.degToRad(state.ry);
    g.position.y = floatY;
  });

  return (
    <group ref={root}>
      {[0, 1, 2, 3].map((i) => (
        <Slice key={i} index={i} size={size} stateRef={stateRef} />
      ))}
    </group>
  );
}

export default function GRObject({
  stateRef,
  size = 1.6,
  className,
}: {
  stateRef: RefObject<GRState>;
  size?: number;
  className?: string;
}) {
  return (
    <Canvas
      className={className}
      dpr={[1, 1.6]}
      gl={{ antialias: true, alpha: true, localClippingEnabled: true }}
      camera={{ position: [0, 0, 6], fov: 32 }}
      style={{ width: "100%", height: "100%" }}
    >
      <ambientLight intensity={0.55} />
      <directionalLight position={[-4, 2, 5]} intensity={1.6} color="#dfe6ff" />
      <directionalLight position={[3, -1, -4]} intensity={1.1} color="#afc4ff" />
      <Rig size={size} stateRef={stateRef} />
    </Canvas>
  );
}
